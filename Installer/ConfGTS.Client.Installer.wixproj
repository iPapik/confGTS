<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>ConfGTS-0.15.1-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDir Condition="'$(PublishDir)'==''">$(MSBuildThisFileDirectory)..\artifacts\publish</PublishDir>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressIces>ICE03;ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Package.wxs" />
    <BindPath Include="$(PublishDir)" BindName="publish" />
  </ItemGroup>
</Project>
