<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="ConfGTS"
      Manufacturer="СГМУП Городские тепловые сети"
      Version="0.15.0"
      UpgradeCode="CC8C0A11-1DC6-44D3-BA24-F2B79EDBF2F6"
      Language="1049"
      Scope="perMachine">

    <SummaryInformation
        Description="ConfGTS — клиент видеоконференцсвязи"
        Manufacturer="СГМУП Городские тепловые сети" />

    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия ConfGTS." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CompanyFolder" Name="ГТС">
        <Directory Id="INSTALLFOLDER" Name="ConfGTS" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="ConfGTS" Level="1">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.publish)\**">
        <Exclude Files="!(bindpath.publish)\**\*.pdb" />
      </Files>
    </Feature>
  </Package>
</Wix>
