<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>ConfGTS-Setup-0.15.1-x64</OutputName>
    <MsiDir Condition="'$(MsiDir)'==''">$(MSBuildThisFileDirectory)..\..\artifacts\msi</MsiDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <BindPath Include="$(MsiDir)" BindName="msi" />
  </ItemGroup>
</Project>
