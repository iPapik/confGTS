<Window
    x:Class="ConfGTS.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F2F8FD">
        <Grid x:Name="LoginView">
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E4F4FF" Offset="0"/>
                        <GradientStop Color="#F9FCFF" Offset="0.55"/>
                        <GradientStop Color="#DCEFF9" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Canvas IsHitTestVisible="False" Opacity="0.40">
                    <Ellipse Width="760" Height="760" Canvas.Left="850" Canvas.Top="-250" Fill="#65CBE5"/>
                    <Ellipse Width="900" Height="900" Canvas.Left="1030" Canvas.Top="240" Fill="#119AB5" Opacity="0.35"/>
                    <Ellipse Width="620" Height="620" Canvas.Left="-250" Canvas.Top="520" Fill="#95CFF1" Opacity="0.35"/>
                </Canvas>
                <Border Width="590" Padding="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="30" Background="#F9FFFFFF" BorderBrush="#E1ECF6" BorderThickness="1">
                    <StackPanel Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#176FAB" Offset="0"/>
                                        <GradientStop Color="#0BB8B4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="White"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ГТС" FontSize="38" FontWeight="Bold" Foreground="#092B56"/>
                                <TextBlock Text="Городские тепловые сети" FontSize="15" Foreground="#65748C"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="ConfGTS" FontSize="46" FontWeight="Bold" Foreground="#092B56"/>
                            <TextBlock Text="Сервис видеоконференцсвязи" FontSize="20" Foreground="#65748C" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="LoginBox" Header="Логин" PlaceholderText="Доменная учетная запись" FontSize="17"/>
                        <PasswordBox x:Name="PasswordBox" Header="Пароль" PlaceholderText="Введите пароль" FontSize="17"/>
                        <Button x:Name="LoginButton" Style="{StaticResource PrimaryButtonStyle}" Height="54"
                                HorizontalAlignment="Stretch" Click="LoginButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <TextBlock Text="Войти" FontSize="18"/>
                                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
                            </StackPanel>
                        </Button>
                        <Button Height="50" HorizontalAlignment="Stretch" Background="Transparent"
                                BorderBrush="#BBD3E5" BorderThickness="1" CornerRadius="12" Click="GuestButton_Click">
                            <TextBlock Text="Войти как гость" Foreground="#157EAD" FontWeight="SemiBold"/>
                        </Button>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="ServerDot" Width="12" Height="12" Fill="#BAC5D1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ServerText" Text="Проверка сервера…" FontSize="16" Foreground="#52637A"/>
                            </StackPanel>
                            <Button Grid.Column="1" Background="Transparent" Click="SettingsButton_Click">
                                <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#52637A"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="LoginError" Foreground="#B42318" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="ConfGTS 0.15.0  |  © ГТС, 2026" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" Margin="0,0,0,28" Foreground="#73839A"/>
            </Grid>
        </Grid>

        <Grid x:Name="DashboardView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#FBFDFF" BorderBrush="#DDE8F2" BorderThickness="0,0,1,0">
                <Grid Padding="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="48" Height="48" CornerRadius="14" Background="#157EAD">
                            <FontIcon Glyph="&#xE714;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="23"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ГТС" FontSize="24" FontWeight="Bold" Foreground="#092B56"/>
                            <TextBlock Text="ConfGTS" Foreground="#65748C"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,38,0,0" Spacing="8">
                        <Button Background="#E2F2FC" CornerRadius="12" HorizontalContentAlignment="Left" Padding="15,12">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" Foreground="#157EAD"/>
                                <TextBlock Text="Главная" Foreground="#092B56" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" CornerRadius="12" HorizontalContentAlignment="Left" Padding="15,12">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" Foreground="#52637A"/>
                                <TextBlock Text="Конференции" Foreground="#52637A"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" CornerRadius="12" HorizontalContentAlignment="Left" Padding="15,12">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE716;" FontFamily="Segoe Fluent Icons" Foreground="#52637A"/>
                                <TextBlock Text="Контакты" Foreground="#52637A"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" CornerRadius="12" HorizontalContentAlignment="Left" Padding="15,12" Click="SettingsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="#52637A"/>
                                <TextBlock Text="Настройки" Foreground="#52637A"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Ellipse Width="11" Height="11" Fill="#31B657" VerticalAlignment="Center"/>
                            <TextBlock Text="Сервер доступен" Foreground="#52637A"/>
                        </StackPanel>
                        <Button Content="Выйти" Click="LogoutButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Padding="28" Spacing="20">
                    <Border Height="260" CornerRadius="24" Padding="36">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EEF8FF" Offset="0"/>
                                <GradientStop Color="#D8EFF8" Offset="0.5"/>
                                <GradientStop Color="#A9DDE9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Canvas IsHitTestVisible="False" Opacity="0.35">
                                <Ellipse Width="520" Height="520" Canvas.Left="700" Canvas.Top="-260" Fill="#15B7BC"/>
                                <Ellipse Width="430" Height="430" Canvas.Left="880" Canvas.Top="30" Fill="#157EAD"/>
                            </Canvas>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Добро пожаловать," FontSize="27" Foreground="#092B56"/>
                                <TextBlock x:Name="WelcomeName" Text="Пользователь!" FontSize="52" FontWeight="Bold" Foreground="#092B56"/>
                                <TextBlock Text="Проводите встречи, общайтесь и работайте вместе с ConfGTS"
                                           FontSize="20" Foreground="#52637A" MaxWidth="560" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="122" Background="White" BorderBrush="#DDE8F2" BorderThickness="1"
                                CornerRadius="18" HorizontalContentAlignment="Stretch">
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="16" Background="#157EAD">
                                    <FontIcon Glyph="&#xE8AA;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="27"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Создать конференцию" FontSize="18" FontWeight="SemiBold" Foreground="#092B56"/>
                                    <TextBlock Text="Начать встречу сейчас" Foreground="#73839A"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Height="122" Background="White" BorderBrush="#DDE8F2" BorderThickness="1"
                                CornerRadius="18" HorizontalContentAlignment="Stretch">
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="16" Background="#0A8FA8">
                                    <FontIcon Glyph="&#xE71B;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="27"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Подключиться по коду" FontSize="18" FontWeight="SemiBold" Foreground="#092B56"/>
                                    <TextBlock Text="Войти в конференцию" Foreground="#73839A"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="2" Height="122" Background="White" BorderBrush="#DDE8F2" BorderThickness="1"
                                CornerRadius="18" HorizontalContentAlignment="Stretch">
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="16" Background="#2A8ED0">
                                    <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="27"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Запланировать" FontSize="18" FontWeight="SemiBold" Foreground="#092B56"/>
                                    <TextBlock Text="Создать в календаре" Foreground="#73839A"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <Border Background="White" BorderBrush="#DDE8F2" BorderThickness="1" CornerRadius="20" Padding="22">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="Предстоящие конференции" FontSize="21" FontWeight="SemiBold" Foreground="#092B56"/>
                                <Button Content="Обновить" HorizontalAlignment="Right" Click="RefreshRoomsButton_Click"/>
                            </Grid>
                            <ItemsControl x:Name="RoomsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,5" Padding="16" CornerRadius="13" BorderBrush="#DDE8F2"
                                                BorderThickness="1" Background="#FBFDFF">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#092B56"/>
                                                <TextBlock Text="{Binding Id}" Foreground="#73839A"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="RoomsEmptyText" Text="Нет доступных конференций" Foreground="#73839A"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
