<Window
    x:Class="ConfGTS.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#EEF7FC">
        <Grid x:Name="LoginView">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#D4E3EE"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="44">
                    <StackPanel>
                        <Border Width="76" Height="76" HorizontalAlignment="Center"
                                Background="#157EAD" CornerRadius="20" Margin="0,0,0,14">
                            <TextBlock Text="ГТС" Foreground="White" FontSize="23" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="ConfGTS" FontSize="44" FontWeight="Bold"
                                   Foreground="#092B56" HorizontalAlignment="Center" />
                        <TextBlock Text="Сервис видеоконференцсвязи" FontSize="18"
                                   Foreground="#65748C" HorizontalAlignment="Center"
                                   Margin="0,4,0,28" />

                        <TextBlock Text="Логин" Foreground="#52637A" FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="LoginBox" PlaceholderText="Доменная учетная запись"
                                 FontSize="17" Margin="0,0,0,16" />

                        <TextBlock Text="Пароль" Foreground="#52637A" FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordBox" PlaceholderText="Введите пароль"
                                     FontSize="17" Margin="0,0,0,20" />

                        <Button x:Name="LoginButton" Height="54"
                                HorizontalAlignment="Stretch"
                                Background="#157EAD" Foreground="White"
                                Click="LoginButton_Click">
                            <TextBlock Text="Войти" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </Button>

                        <Button Height="48" HorizontalAlignment="Stretch"
                                Margin="0,10,0,0"
                                Click="GuestButton_Click">
                            <TextBlock Text="Войти как гость" Foreground="#157EAD"
                                       FontWeight="SemiBold" />
                        </Button>

                        <Border Height="1" Background="#D9E4F1" Margin="0,22,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ServerDot" Width="12" Height="12"
                                     Fill="#BAC5D1" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServerText" Grid.Column="1"
                                       Text="Проверка сервера…"
                                       FontSize="15" Foreground="#52637A"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <Button Grid.Column="2" Content="Настройки"
                                    Click="SettingsButton_Click" />
                        </Grid>

                        <TextBlock x:Name="LoginError" Foreground="#B42318"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="ConfGTS 0.15.2  |  © ГТС, 2026"
                           HorizontalAlignment="Center"
                           Foreground="#73839A"
                           Margin="0,0,0,24" />
            </Grid>
        </Grid>

        <Grid x:Name="DashboardView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#DDE8F2"
                    BorderThickness="0,0,1,0">
                <Grid Padding="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Border Width="56" Height="56" Background="#157EAD"
                                CornerRadius="16" HorizontalAlignment="Left">
                            <TextBlock Text="ГТС" Foreground="White"
                                       FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ConfGTS" FontSize="21" FontWeight="Bold"
                                   Foreground="#092B56" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,36,0,0">
                        <Button Content="Главная" HorizontalAlignment="Stretch"
                                Margin="0,0,0,8" />
                        <Button Content="Конференции" HorizontalAlignment="Stretch"
                                Margin="0,0,0,8" />
                        <Button Content="Контакты" HorizontalAlignment="Stretch"
                                Margin="0,0,0,8" />
                        <Button Content="Настройки" HorizontalAlignment="Stretch"
                                Click="SettingsButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="● Сервер доступен"
                                   Foreground="#31A85B" Margin="0,0,0,12" />
                        <Button Content="Выйти"
                                HorizontalAlignment="Stretch"
                                Click="LogoutButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Padding="30">
                    <Border Background="#DCEFF8"
                            BorderBrush="#C9DDE9"
                            BorderThickness="1"
                            CornerRadius="22"
                            Padding="32"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Добро пожаловать,"
                                       FontSize="26" Foreground="#52637A" />
                            <TextBlock x:Name="WelcomeName"
                                       Text="Пользователь!"
                                       FontSize="48" FontWeight="Bold"
                                       Foreground="#092B56" />
                            <TextBlock Text="Проводите встречи, общайтесь и работайте вместе с ConfGTS"
                                       FontSize="19" Foreground="#52637A"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White"
                                BorderBrush="#DDE8F2" BorderThickness="1"
                                CornerRadius="16" Padding="20" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Создать конференцию"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="#092B56" />
                                <TextBlock Text="Начать встречу сейчас"
                                           Foreground="#73839A" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White"
                                BorderBrush="#DDE8F2" BorderThickness="1"
                                CornerRadius="16" Padding="20" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="Подключиться"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="#092B56" />
                                <TextBlock Text="Войти по коду конференции"
                                           Foreground="#73839A" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White"
                                BorderBrush="#DDE8F2" BorderThickness="1"
                                CornerRadius="16" Padding="20" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Запланировать"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="#092B56" />
                                <TextBlock Text="Создать встречу заранее"
                                           Foreground="#73839A" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="White"
                            BorderBrush="#DDE8F2"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="22">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Предстоящие конференции"
                                           FontSize="21" FontWeight="SemiBold"
                                           Foreground="#092B56" />
                                <Button Content="Обновить"
                                        HorizontalAlignment="Right"
                                        Click="RefreshRoomsButton_Click" />
                            </Grid>

                            <ListView x:Name="RoomsList" MinHeight="160">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0EAF2"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#092B56" />
                                                <TextBlock Text="{Binding Id}"
                                                           Foreground="#73839A" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock x:Name="RoomsEmptyText"
                                       Text="Нет доступных конференций"
                                       Foreground="#73839A" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
